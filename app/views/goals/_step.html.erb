<div class="grid">
  <div class="row">
    <div class="col">
      <% if step.status == false %>
        <%= render "steps/status_form", step: step %>
      <% else %>
        ✅ 
      <% end %>
    </div>

    <div class="col">
      <%= step.resources %> 
    </div>

    <div class="col">
      <%= step.skills %>
    </div>

    <div class="col">
      <%= step.time_allotted.strftime("%m/%d/%y") %>
    </div>

    <div class="col">
      <%= link_to action_plan_step_path(step.action_plan_id, step), data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? This is NOT reversible" }, method: :delete do %>
        <i class='fa-solid fa-trash'></i>
      <% end %>
    </div>

    <div class="col">
      <%= link_to edit_action_plan_step_path(step.action_plan_id, step) do %>
        <i class='fa-solid fa-pen-to-square'></i>
      <% end %>
    </div>
  </div>
</div>
