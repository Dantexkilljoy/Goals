<div id="<%= dom_id(step) %>_form" class="grid">
  <div id="<%= dom_id(step) %>" class="row" >
    <p><%= step.name %></p>
    <div class="col">
      <%= render "steps/status_form", step: step  %>
    </div>

    <div class="col">
      <%= step.resources %> 
    </div>

    <div class="col">
      <%= step.skills %>
    </div>

    <div class="col">
      <%= step.time_allotted.strftime("%m/%d/%y") %>
    </div>

    <div class="col">
      <%= link_to action_plan_step_path(step.action_plan_id, step), method: :delete, class: "btn btn-link btn-sm", remote: true do %>
        <i class="fas fa-trash fa-fw"></i>
      <% end %>
    </div>

    <div class="col">
      <%= link_to edit_action_plan_step_path(step.action_plan_id, step) do %>
        <i class='fa-solid fa-pen-to-square'></i>
      <% end %>
    </div>
  </div>
</div>
