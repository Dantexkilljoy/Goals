<div class="container px-4 text-center">
    <div class="row gx-5">
      <div class="col">
        <%= link_to action_plan_path(action_plan), data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? This is NOT reversible and will delete all of your steps you have created." }, method: :delete do %>
        <i class='fa-solid fa-trash'></i>
        <% end %>
      </div>

      <div class="col">
        You started your activity on <%= action_plan.date %>
      </div>

      <div class="col">
        <%= link_to edit_action_plan_path(action_plan) do %>
          <i class='fa-solid fa-pen-to-square'></i>
        <% end %>
      </div>
    </div>
</div>
