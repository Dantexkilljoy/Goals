<div>
  <h2>
    In Progress <span class="badge bg-warning-subtle border border-black text-dark-emphasis"><%= @list_of_incomplete_goals.count %></span>
  </h2>
</div>

<hr>

<div class="grid text-center">
  <div class="row">
    <% @list_of_incomplete_goals.each do |a_goal| %>
    <div class="p-3">
      <div class="card text-center bg-warning-subtle border border-black">
        <div class="card-body">
          <h5 class="card-title"><%= a_goal.name %></h5>
          <h6 class="card-subtitle mb-2 text-body-secondary"><%= a_goal.progress %> started on <%= a_goal.date %></h6>
          <p class="card-text"><%= a_goal.priorities %></p>
          <%= link_to "Show Details", a_goal, class: "link-dark link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" %>
        </div>
      </div>
    </div>
    <% end %>
  </div>
</div>

<hr>

<div>
  <h2>
    Completed <span class="badge bg-success-subtle border border-black text-dark-emphasis"><%= @list_of_completed_goals.count %></span>
  </h2>
</div>

<hr>

<div class="grid text-center">
  <div class="row">
  <% @list_of_completed_goals.each do |goal| %>
    <div class="p-3">
      <div class="card text-center bg-success-subtle border border-black"">
        <div class="card-body">
          <h5 class="card-title"><%= goal.name %></h5>
          <h6 class="card-subtitle mb-2 text-body-secondary"><%= goal.progress %> started on <%= goal.date %></h6>
          <p class="card-text"><%= goal.priorities %></p>
          <%= link_to "Show Details", goal, class: "link-dark link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" %>
        </div>
      </div>
    </div>
  <% end %>
  </div>
</div>

<hr>
