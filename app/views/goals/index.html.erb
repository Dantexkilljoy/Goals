<div>
  <div>
    <h1>
      Your Goals
    </h1>
  </div>
</div>

<hr>

<div>
  <div>
    <table border="1">
      <tr>
        <th>
          ID
        </th>

        <th>
          Name
        </th>

        <th>
          Date
        </th>

        <th>
          User
        </th>

        <th>
          Progress
        </th>

        <th>
          Priorities
        </th>

        <th>
          Created at
        </th>

        <th>
          Updated at
        </th>

        <th>
        </th>
      </tr>

      <% @list_of_goals.each do |a_goal| %>
      <tr>
        <td>
          <%= a_goal.id %>
        </td>

        <td>
          <%= a_goal.name %>
        </td>

        <td>
          <%= a_goal.date %>
        </td>

        <td>
          <%= a_goal.user_id %>
        </td>

        <td>
          <%= a_goal.progress %>
        </td>

        <td>
          <%= a_goal.priorities %>
        </td>

        <td>
          <%= time_ago_in_words(a_goal.created_at) %> ago
        </td>
        <td>
          <%= time_ago_in_words(a_goal.updated_at) %> ago
        </td>

        <td>
          <a href="/goals/<%= a_goal.id %>">
            Show details
          </a>
        </td>
      </tr>
      <% end %>
    </table>
  </div>
</div>

<hr>
