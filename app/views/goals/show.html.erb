<div>
  <div>
    <h1>
      <%= @the_goal.name %>
    </h1>

    <div>
      <div>
        <%= link_to "Go back", goals_path %>
      </div>

      <div>
       <%= link_to "Delete", goal_path(@the_goal), data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? This is NOT reversible" }, method: :delete %>
      </div>
    </div>

    <dl>
      <dt>
        Date
      </dt>
      <dd>
        <%= @the_goal.date %>
      </dd>

      <dt>
        Progress
      </dt>
      <dd>
        <%= @the_goal.progress %>
      </dd>

      <dt>
        Priorities
      </dt>
      <dd>
        <%= @the_goal.priorities %>
      </dd>

      <dt>
        Updated at
      </dt>
      <dd>
        <%= time_ago_in_words(@the_goal.updated_at) %> ago
      </dd>
    </dl>
  </div>
</div>

<hr>

<%= link_to "Edit Goal", edit_goal_path %>
