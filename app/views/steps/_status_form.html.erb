<li id="<%= dom_id(step) %>_form" class="list-group-item">
<% if step.status == false %>
  <%= form_for [step.action_plan, step], remote: true do |form| %>
    <div>
    <%= form.hidden_field  :status, value: true %>
    </div>
    <%= button_tag "Mark as complete", class: "btn btn-outline-success" %>
  <% end %>
<% else %>
  <%= form_for [step.action_plan, step], remote: true do |form| %>
    <div>
    <%= form.hidden_field  :status, value: false %>
    </div>
    <%= button_tag "Mark as incomplete", class: "btn btn-outline-danger" %>
  <% end %>
<% end %>
</li>
