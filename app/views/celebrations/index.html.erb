<div class="container">
  <div class="card-group p-3 g-3">
  <% @list_of_celebrations.each do |celebration| %>
   <%= link_to celebration, class: "text-decoration-none" do %>
      <div class="card bg-transparent">
        <img src="<%= celebration.image %>" class="card-img-top" alt="a picture of you celebrating  <%= celebration.goal.name %>">
        <div class="card-body">
          <h5 class="card-title"><%= celebration.activity %></h5>
        </div>
      </div>
    <% end %>
  <% end %>
  </div>
</div>
