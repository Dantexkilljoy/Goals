<div>
  <div>
    <h1>
      List of all celebrations
    </h1>
  </div>
</div>

<hr>

<div>
  <div>
    <table border="1">
      <tr>
        <th>
          ID
        </th>

        <th>
          Goal
        </th>

        <th>
          Activity
        </th>

        <th>
          Image
        </th>

        <th>
          Updated at
        </th>

        <th>
        </th>
      </tr>

      <% @list_of_celebrations.each do |a_celebration| %>
      <tr>
        <td>
          <%= a_celebration.id %>
        </td>

        <td>
          <%= a_celebration.goal.name %>
        </td>

        <td>
          <%= a_celebration.activity %>
        </td>

        <td>
          <%= a_celebration.image %>
        </td>

        <td>
          <%= time_ago_in_words(a_celebration.updated_at) %> ago
        </td>

        <td>
          <a href="/celebrations/<%= a_celebration.id %>">
            Show details
          </a>
        </td>
      </tr>
      <% end %>
    </table>
  </div>
</div>

<hr>
