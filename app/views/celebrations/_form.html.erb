<%= form_with model: @celebration do |form| %>
  <div>
    <%= form.label :activity, "What/where did you do/go?" %>
    <%= form.text_field :activity %>
  </div>

   <div>
    <%= form.label :image, "Show them pics!" %>
    <%= form.file_field :image %>
  </div>

  <div class="my-2">
    <% if @celebration.goal_id != nil %>
    <% else %>
      <%= form.collection_select(:goal_id, current_user.goals.reject { |goal| goal.progress == "incomplete" || goal.celebrations.exists? }, :id, :name, { prompt: "Select a goal", class: "form-select" }) %>
    <% end %>
  </div>
  
  <%= button_tag "Create Celebration" %>
<% end %>
